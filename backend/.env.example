# ═══════════════════════════════════════════════════════════════
# DevPilot — Backend Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────
DEVPILOT_DEBUG=true
DEVPILOT_LOG_LEVEL=DEBUG
DEVPILOT_HOST=0.0.0.0
DEVPILOT_PORT=8000
# DEVPILOT_CORS_ORIGINS=["http://localhost:3000"]

# ── Default LLM Provider ──────────────────────────────────────
# nvidia (NIM) is the default; unset NVIDIA_API_KEY in your own .env until you
# have a key and DevPilot will fail over to the next configured provider.
DEVPILOT_LLM_PROVIDER=nvidia
DEVPILOT_LLM_MODEL=gpt-4o-mini
DEVPILOT_LLM_TEMPERATURE=0.3
DEVPILOT_LLM_MAX_TOKENS=4096

# ── OpenAI ─────────────────────────────────────────────────────
# Get your key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1  # optional override

# ── Anthropic ──────────────────────────────────────────────────
# Get your key: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# ── Gemini (Google AI) ──────────────────────────────────────────
# Get a FREE key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key
# Tier (Phase 20B B1): 'free' (default) = per-model ~20 req/day buckets with
# automatic cross-model failover + 24h exhaustion markers; 'paid' = billing
# attached to the key (same key format) — disables daily-quota failover and
# exhaustion markers, only transient per-minute 429s are retried.
# DEVPILOT_GEMINI_TIER=free
# Optional paid-tier model candidates (first is the default), e.g.:
# DEVPILOT_GEMINI_PAID_MODELS=gemini-3.6-pro-preview,gemini-3.6-flash

# ── GitHub ─────────────────────────────────────────────────────
# Generate a token: https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_your-github-token

# ── Database (PostgreSQL) ─────────────────────────────────────
# DevPilot uses PostgreSQL via SQLAlchemy 2.x + asyncpg.
# DATABASE_URL is required for Phase 11 persistence.
# Integration tests use TEST_DATABASE_URL (must differ from DATABASE_URL).
#
# DATABASE_URL=postgresql+asyncpg://devpilot:<password>@localhost:5432/devpilot_dev
# TEST_DATABASE_URL=postgresql+asyncpg://devpilot:<password>@localhost:5432/devpilot_test

# ── Provider Router (Phase 19B) ───────────────────────────────
# DEVPILOT_PROVIDER_ROUTING_ENABLED=true
# JSON-array form is required when set from .env (pydantic-settings decodes
# list fields as JSON before validators run):
# DEVPILOT_PROVIDER_PRIORITY=["nvidia","gemini","cloudflare","ollama_cloud","opencode_zen","openai","anthropic","openrouter","ollama","fake"]
# Disable providers entirely (excluded from routing, report enabled=false).
# Must be a JSON array from .env (a comma string only works when the value is
# passed programmatically) — e.g. kill a provider without deleting its key:
# DEVPILOT_PROVIDER_DISABLED=["anthropic","openai"]
# Per-call timeout before failing over. Default 60s — the cold-start-optimized
# choice: it bounds how long a cold NVIDIA pod (60-370s first call) delays a
# request, failing over fast to the sub-second backups. Raise it only if you
# prefer to wait out a legit NVIDIA cold start instead of using a backup:
# DEVPILOT_PROVIDER_TIMEOUT_SECONDS=60
# DEVPILOT_PROVIDER_RETRY_MAX=2
# DEVPILOT_PROVIDER_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
# DEVPILOT_PROVIDER_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
# Mid-stream token-loss recovery: max prefix-resends per streaming call when a
# stream drops after delivering tokens (0 disables recovery):
# DEVPILOT_PROVIDER_STREAM_RESUME_MAX=3

# ── OpenRouter (Phase 19B) ─────────────────────────────────────
# OpenAI-compatible multi-model router (https://openrouter.ai/api/v1).
# Key: https://openrouter.ai/settings/keys
# OPENROUTER_API_KEY=sk-or-v1-...
# Optional model override (independent of DEVPILOT_LLM_MODEL). Use a ':free'
# slug (e.g. poolside/laguna-s-2.1:free) to stay on the free tier; unset
# defaults to 'openrouter/auto' (auto-routing, may pick paid models).
# DEVPILOT_OPENROUTER_MODEL=poolside/laguna-s-2.1:free

# ── NVIDIA NIM ─────────────────────────────────────────────────
# OpenAI-compatible inference endpoint (https://integrate.api.nvidia.com/v1).
# Get a key: https://build.nvidia.com
# NVIDIA_API_KEY=nvapi-...
# Optional model override (independent of DEVPILOT_LLM_MODEL). Examples:
#   meta/llama-3.1-8b-instruct (default — fastest cold start, best free-tier),
#   meta/llama-3.3-70b-instruct, nvidia/llama-3.3-nemotron-super-49b-v1
# DEVPILOT_NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# Optional base URL override — point at a self-hosted NIM microservice:
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Per-request client timeout (generous for NIM cold-start pod spin-up, which
# can take 60-370s on the first call) and transport-level retries:
# DEVPILOT_NVIDIA_TIMEOUT_SECONDS=300
# DEVPILOT_NVIDIA_MAX_RETRIES=2

# ── Cloudflare Workers AI (Phase 20F) ─────────────────────────
# OpenAI-compatible inference endpoint (https://developers.cloudflare.com/workers-ai/).
# Key: https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_API_KEY=cf-...
# Account id (builds the default base URL):
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# Optional overrides (independent of DEVPILOT_LLM_MODEL). Default is
# '@cf/meta/llama-4-scout-17b-16e-instruct' — live-verified fastest Workers AI
# model (~0.5s TTF, 17B MoE). The 2024-era '@cf/meta/llama-3.1-8b-instruct' was
# deprecated 2026-05-30 (returns 410); a slower 8B alternative is
# '@cf/meta/llama-3.1-8b-instruct-fp8':
# DEVPILOT_CLOUDFLARE_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
# CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/your-account-id/ai/v1
# DEVPILOT_CLOUDFLARE_TIMEOUT_SECONDS=60
# DEVPILOT_CLOUDFLARE_MAX_RETRIES=2

# ── Ollama Cloud (backup provider) ─────────────────────────────
# Hosted models (including GPU-only sizes) via the OpenAI-compatible endpoint
# https://ollama.com/v1. Key: https://ollama.com/settings/keys
# OLLAMA_CLOUD_API_KEY=ollama-...
# Optional model override (independent of DEVPILOT_LLM_MODEL). Default
# 'gemma4:31b' (live-verified reliable even at small max_tokens; the
# gpt-oss/nemotron models on this endpoint return empty content at
# max_tokens<64). Good alternate: 'gpt-oss:120b' for bigger runs:
# DEVPILOT_OLLAMA_CLOUD_MODEL=gemma4:31b
# OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
# DEVPILOT_OLLAMA_CLOUD_TIMEOUT_SECONDS=60
# DEVPILOT_OLLAMA_CLOUD_MAX_RETRIES=2

# ── OpenCode Zen (backup provider) ─────────────────────────────
# OpenAI-compatible gateway (https://opencode.ai/zen). Free-tier model ids end
# in '-free' (e.g. 'deepseek-v4-flash-free', 'big-pickle',
# 'north-mini-code-free'). Key: https://opencode.ai/zen/settings/keys
# OPENCODE_ZEN_API_KEY=sk-...
# Optional model override (independent of DEVPILOT_LLM_MODEL). Default
# 'deepseek-v4-flash-free' (live-verified):
# DEVPILOT_OPENCODE_ZEN_MODEL=deepseek-v4-flash-free
# OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
# DEVPILOT_OPENCODE_ZEN_TIMEOUT_SECONDS=60
# DEVPILOT_OPENCODE_ZEN_MAX_RETRIES=2

# ── Generic OpenAI-compatible endpoint (Phase 20F) ─────────────
# Any server that speaks the OpenAI chat-completions API — self-hosted
# vLLM/TGI, llama.cpp, LM Studio, a remote Ollama server, or an
# OpenAI-compatible cloud gateway:
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
# Optional key for cloud gateways (local servers usually ignore it):
# OPENAI_COMPATIBLE_API_KEY=...
# Model served by the endpoint (set for real use):
# DEVPILOT_OPENAI_COMPATIBLE_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
# DEVPILOT_OPENAI_COMPATIBLE_TIMEOUT_SECONDS=60
# DEVPILOT_OPENAI_COMPATIBLE_MAX_RETRIES=2

# ── Typed per-capability fallbacks (Phase 20B) ────────────────
# Restrict which providers are tried for each agent stage instead of the
# global DEVPILOT_PROVIDER_PRIORITY. Format: cap:prov1,prov2;cap2:prov3
# Capabilities: analysis, planning, coding, testing, review, reasoning,
# general. Example — coding needs long output (bigger context first):
# DEVPILOT_LLM_PROVIDER_FALLBACKS=coding:gemini,openai;planning:anthropic,gemini

# ── Embedding Provider (Phase 5) ──────────────────────────────
# Provider: 'fake' (default, no API key needed) or 'openai'.
# NOTE: 'anthropic' is NOT supported — Anthropic offers no embeddings
# endpoint (config rejects it).
DEVPILOT_EMBEDDING_PROVIDER=fake
# DEVPILOT_EMBEDDING_MODEL=text-embedding-3-small
# DEVPILOT_EMBEDDING_DIMENSION=256
#
# When using 'openai' provider:
# - Reuses OPENAI_API_KEY from the LLM provider section above
# - Supports text-embedding-3-small (256d), text-embedding-3-large (3072d)
# - Recommended dimension for code: 256

# ── Coding & Patching (Phase 6) ────────────────────────────────
# DEVPILOT_CODING_MAX_FILES_PER_PATCH=20
# DEVPILOT_CODING_MAX_FILE_SIZE=500000
# DEVPILOT_CODING_MAX_PATCH_SIZE=1000000
# DEVPILOT_CODING_ALLOW_DELETE=false
# DEVPILOT_CODING_WORKSPACE_ROOT=

# ── Testing & Execution (Phase 7) ──────────────────────────────
DEVPILOT_TEST_DEFAULT_TIMEOUT=60
DEVPILOT_TEST_MAX_OUTPUT_BYTES=1048576
DEVPILOT_TEST_MAX_COMMANDS=10
DEVPILOT_TEST_ALLOW_BUILD=false
DEVPILOT_TEST_ALLOW_LINT=false
DEVPILOT_TEST_ALLOW_TYPECHECK=false

# ── Repair (Phase 8) ───────────────────────────────────────────
DEVPILOT_REPAIR_MAX_ATTEMPTS=3
DEVPILOT_REPAIR_PROVIDER_RETRIES=1
DEVPILOT_REPAIR_MAX_CONTEXT_BYTES=200000
DEVPILOT_REPAIR_ALLOW_TEST_MODIFICATION=false
DEVPILOT_REPAIR_ALLOW_CONFIG_MODIFICATION=false
