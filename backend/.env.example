# ═══════════════════════════════════════════════════════════════
# DevPilot — Backend Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────
DEVPILOT_DEBUG=true
DEVPILOT_LOG_LEVEL=DEBUG
DEVPILOT_HOST=0.0.0.0
DEVPILOT_PORT=8000
# DEVPILOT_CORS_ORIGINS=["http://localhost:3000"]

# ── Default LLM Provider ──────────────────────────────────────
DEVPILOT_LLM_PROVIDER=openai
DEVPILOT_LLM_MODEL=gpt-4o-mini
DEVPILOT_LLM_TEMPERATURE=0.3
DEVPILOT_LLM_MAX_TOKENS=4096

# ── OpenAI ─────────────────────────────────────────────────────
# Get your key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1  # optional override

# ── Anthropic ──────────────────────────────────────────────────
# Get your key: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# ── Gemini (Google AI) ──────────────────────────────────────────
# Get a FREE key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key
# Tier (Phase 20B B1): 'free' (default) = per-model ~20 req/day buckets with
# automatic cross-model failover + 24h exhaustion markers; 'paid' = billing
# attached to the key (same key format) — disables daily-quota failover and
# exhaustion markers, only transient per-minute 429s are retried.
# DEVPILOT_GEMINI_TIER=free
# Optional paid-tier model candidates (first is the default), e.g.:
# DEVPILOT_GEMINI_PAID_MODELS=gemini-3.6-pro-preview,gemini-3.6-flash

# ── GitHub ─────────────────────────────────────────────────────
# Generate a token: https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_your-github-token

# ── Database (PostgreSQL) ─────────────────────────────────────
# DevPilot uses PostgreSQL via SQLAlchemy 2.x + asyncpg.
# DATABASE_URL is required for Phase 11 persistence.
# Integration tests use TEST_DATABASE_URL (must differ from DATABASE_URL).
#
# DATABASE_URL=postgresql+asyncpg://devpilot:<password>@localhost:5432/devpilot_dev
# TEST_DATABASE_URL=postgresql+asyncpg://devpilot:<password>@localhost:5432/devpilot_test

# ── Provider Router (Phase 19B) ───────────────────────────────
# DEVPILOT_PROVIDER_ROUTING_ENABLED=true
# DEVPILOT_PROVIDER_PRIORITY=gemini,openai,anthropic,fake
# DEVPILOT_PROVIDER_TIMEOUT_SECONDS=60
# DEVPILOT_PROVIDER_RETRY_MAX=2
# DEVPILOT_PROVIDER_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
# DEVPILOT_PROVIDER_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
# Mid-stream token-loss recovery: max prefix-resends per streaming call when a
# stream drops after delivering tokens (0 disables recovery):
# DEVPILOT_PROVIDER_STREAM_RESUME_MAX=3

# ── Typed per-capability fallbacks (Phase 20B) ────────────────
# Restrict which providers are tried for each agent stage instead of the
# global DEVPILOT_PROVIDER_PRIORITY. Format: cap:prov1,prov2;cap2:prov3
# Capabilities: analysis, planning, coding, testing, review, reasoning,
# general. Example — coding needs long output (bigger context first):
# DEVPILOT_LLM_PROVIDER_FALLBACKS=coding:gemini,openai;planning:anthropic,gemini

# ── Embedding Provider (Phase 5) ──────────────────────────────
# Provider: 'fake' (default, no API key needed) or 'openai'.
# NOTE: 'anthropic' is NOT supported — Anthropic offers no embeddings
# endpoint (config rejects it).
DEVPILOT_EMBEDDING_PROVIDER=fake
# DEVPILOT_EMBEDDING_MODEL=text-embedding-3-small
# DEVPILOT_EMBEDDING_DIMENSION=256
#
# When using 'openai' provider:
# - Reuses OPENAI_API_KEY from the LLM provider section above
# - Supports text-embedding-3-small (256d), text-embedding-3-large (3072d)
# - Recommended dimension for code: 256

# ── Coding & Patching (Phase 6) ────────────────────────────────
# DEVPILOT_CODING_MAX_FILES_PER_PATCH=20
# DEVPILOT_CODING_MAX_FILE_SIZE=500000
# DEVPILOT_CODING_MAX_PATCH_SIZE=1000000
# DEVPILOT_CODING_ALLOW_DELETE=false
# DEVPILOT_CODING_WORKSPACE_ROOT=

# ── Testing & Execution (Phase 7) ──────────────────────────────
DEVPILOT_TEST_DEFAULT_TIMEOUT=60
DEVPILOT_TEST_MAX_OUTPUT_BYTES=1048576
DEVPILOT_TEST_MAX_COMMANDS=10
DEVPILOT_TEST_ALLOW_BUILD=false
DEVPILOT_TEST_ALLOW_LINT=false
DEVPILOT_TEST_ALLOW_TYPECHECK=false

# ── Repair (Phase 8) ───────────────────────────────────────────
DEVPILOT_REPAIR_MAX_ATTEMPTS=3
DEVPILOT_REPAIR_PROVIDER_RETRIES=1
DEVPILOT_REPAIR_MAX_CONTEXT_BYTES=200000
DEVPILOT_REPAIR_ALLOW_TEST_MODIFICATION=false
DEVPILOT_REPAIR_ALLOW_CONFIG_MODIFICATION=false
